<Project Sdk="Microsoft.NET.Sdk">

	<!-- Import tModLoader mod properties -->
	<!-- tML 1.4.5: set tMLTargets (MSBuild property or environment variable) to a 1.4.5 install's tMLMod.targets to build against it; otherwise the shared ModSources targets are used -->
	<Import Project="$(tMLTargets)" Condition="'$(tMLTargets)' != ''" />
	<Import Project="..\tModLoader.targets" Condition="'$(tMLTargets)' == ''" />

	<!-- General -->
	<PropertyGroup>
	  <GenerateDocumentationFile>True</GenerateDocumentationFile>
	</PropertyGroup>
	<ItemGroup>
	  <None Remove="description_workshop.txt" />
	  <None Remove="localization\zh-Hans_Mods.InnoVault.hjson" />
	  <None Remove="Trails\SpecialThanks.txt" />
	</ItemGroup>

	<!-- References -->

</Project>